<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flittly.ai.mapper.ChatHistoryMapper">
    <resultMap id="BaseResultMap" type="com.flittly.ai.model.ChatHistory">
        <id column="id" property="id"/>
        <result column="student_id" property="studentId"/>
        <result column="session_id" property="sessionId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="agent_type" property="agentType"/>
        <result column="metadata" property="metadata"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectByStudentIdAndSessionId" resultMap="BaseResultMap">
        SELECT * FROM chat_history
        WHERE student_id = #{studentId} AND session_id = #{sessionId}
        ORDER BY created_at ASC
    </select>

    <insert id="insert" parameterType="com.flittly.ai.model.ChatHistory" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO chat_history (student_id, session_id, role, content, agent_type, metadata)
        VALUES (#{studentId}, #{sessionId}, #{role}, #{content}, #{agentType}, #{metadata})
    </insert>
</mapper>
